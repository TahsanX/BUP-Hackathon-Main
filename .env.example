# Copy to .env and fill in. Never commit the filled-in file.

# Chain order. Providers without credentials are skipped automatically.
# Drop "ollama" on a host that has no local model (e.g. a serverless mirror).
LLM_PROVIDER_ORDER=gemini,groq,ollama

# gemini-2.0-* was shut down 2026-06-01 and 2.5-* is closed to new projects.
# Upgrade to gemini-3.8-flash if the interpretation eval shows misses.
# GEMINI_API_KEYS accepts a comma-separated pool ("key1,key2"); each key
# becomes its own chain candidate, so one key's rate limit only cools down
# itself instead of taking Gemini out of the chain entirely. A single
# GEMINI_API_KEY also works.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite

# llama-3.3-70b-versatile left the free tier on 2026-08-16.
# Same pooling as above: GROQ_API_KEYS="key1,key2" or a single GROQ_API_KEY.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b

# Baked into the image at build time; no key, no quota, no network.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Wall-clock ceiling for the whole interpretation step. The judge times a
# request out at 30s, so this stays well under it.
LLM_TOTAL_BUDGET_SECONDS=20
LLM_COOLDOWN_SECONDS=30
GEMINI_TIMEOUT_SECONDS=6
GROQ_TIMEOUT_SECONDS=6
OLLAMA_TIMEOUT_SECONDS=9

PORT=8000
LOG_LEVEL=INFO
